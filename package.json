    "nuxt-skill-hub": "^0.3.3",
    "nuxtseo-devtools-host": "^1.0.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "postcss": "8.5.33",
    "sass-embedded": "1.108.2",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
