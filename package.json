{
  "name": "gitpulse",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "extension:build": "bun run --cwd extension build",
    "extension:build:firefox": "bun run --cwd extension build:firefox",
    "extension:zip": "bun run --cwd extension zip",
    "extension:zip:firefox": "bun run --cwd extension zip:firefox",
    "extension:test": "bun test --cwd extension",
    "extension:typecheck": "bun run --cwd extension typecheck",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "prek install",
    "lint": "bunx oxlint ./ --type-aware --ignore-pattern extension/ --ignore-pattern flutter/",
    "lint:fix": "bunx oxlint ./ --fix --type-aware --ignore-pattern extension/ --ignore-pattern flutter/",
    "fmt": "bunx oxfmt ./",
    "fmt:check": "bunx oxfmt --check ./"
  },
  "dependencies": {
    "@comark/nuxt": "^0.7.0",
    "@lucide/vue": "^1.61.0",
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/image": "^2.2.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/robots": "^7.0.2",
    "@octokit/core": "^7.0.8",
    "@primer/css": "^22.3.2",
    "@upstash/redis": "^1.39.0",
    "bulma": "^1.0.4",
    "comark": "^0.8.0",
    "dayjs": "^1.11.23",
    "htmlparser2": "12.0.0",
    "markdown-exit": "1.1.0-beta.2",
    "mermaid": "^12.2.0",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "^0.5.32",
    "nuxt-seo-utils": "^9.0.1",
    "nuxt-site-config": "^5.0.3",
    "redis": "^6.3.0",
    "shiki": "^4.5.0",
    "simplebar-vue": "^2.4.2",
    "vue": "3.5.43",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.4.0",
    "xss": "^1.0.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@j178/prek": "^0.5.7",
    "@nuxtjs/i18n": "^10.6.0",
    "@types/node": "^26.6.5",
    "@vue/compiler-sfc": "3.5.43",
    "happy-dom": "^21.0.4",
    "nuxtseo-devtools-host": "^1.0.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "sass-embedded": "1.100.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13",
    "vue3-simple-icons": "^16.10.0"
  },
  "overrides": {
    "vue": "3.5.43"
  }
}
