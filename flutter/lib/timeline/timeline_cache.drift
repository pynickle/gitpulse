CREATE TABLE cache_account (
  scope TEXT NOT NULL PRIMARY KEY,
  retention_days INTEGER,
  saved_at INTEGER,
  lower_bound INTEGER,
  baseline TEXT,
  pending_follows TEXT,
  partial INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE cache_repositories (
  id TEXT NOT NULL PRIMARY KEY,
  owner TEXT NOT NULL,
  name TEXT NOT NULL
);

CREATE TABLE cache_releases (
  repository_id TEXT NOT NULL,
  id INTEGER NOT NULL,
  published_at INTEGER NOT NULL,
  content TEXT NOT NULL,
  PRIMARY KEY (repository_id, id)
);

CREATE TABLE cache_segments (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  repository_id TEXT NOT NULL,
  cycle TEXT NOT NULL,
  request_cursor TEXT,
  end_cursor TEXT,
  has_older INTEGER NOT NULL,
  incomplete INTEGER NOT NULL
);

CREATE TABLE cache_page_members (
  segment_id INTEGER NOT NULL,
  repository_id TEXT NOT NULL,
  release_id INTEGER NOT NULL,
  PRIMARY KEY (segment_id, repository_id, release_id)
);

CREATE TABLE cache_visible (
  repository_id TEXT NOT NULL,
  release_id INTEGER NOT NULL,
  oldest_shown INTEGER NOT NULL,
  PRIMARY KEY (repository_id, release_id)
);
